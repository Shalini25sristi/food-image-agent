# Optional: image search API keys (DuckDuckGo search works with NO keys)
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Google Drive upload (service account)
# Path to the service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
# ID of the target Drive folder (from the folder's URL:
# https://drive.google.com/drive/folders/<THIS_ID>)
DRIVE_FOLDER_ID=
